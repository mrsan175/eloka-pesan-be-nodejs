// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Koneksi langsung (tanpa pgbouncer) khusus untuk migrate/studio.
  directUrl = env("DATABASE_URL_UNPOOLED")
  // Neon-specific settings for better connection stability
  relationMode = "prisma"
}

// User Management
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders       Order[]
  refreshToken RefreshToken[]
  addresses    Address[]
  staffShops   ShopStaff[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Address {
  id          String  @id @default(cuid())
  userId      String
  label       String // Home, Office, etc
  street      String
  city        String
  province    String
  postalCode  String
  isDefault   Boolean @default(false)
  coordinates String? // lat,lng format

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// Restaurant/Shop Management
model Shop {
  id          String   @id @default(cuid())
  name        String
  description String?
  logo        String?
  address     String
  phone       String
  email       String?
  latitude    Float?   // Geolocation latitude
  longitude   Float?   // Geolocation longitude
  openTime    String   // Format: HH:mm
  closeTime   String   // Format: HH:mm
  isOpen      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  categories Category[]
  orders     Order[]
  staff      ShopStaff[]
  products   ShopProduct[]

  @@map("shops")
}

model ShopStaff {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
  @@map("shop_staff")
}

// Product Management
model Category {
  id          String    @id @default(cuid())
  shopId      String
  name        String
  description String?
  image       String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([shopId])
  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  image       String?
  isAvailable Boolean  @default(true)
  isPopular   Boolean  @default(false)
  stock       Int?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  shopProducts ShopProduct[]
  addons   ProductAddon[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isAvailable])
  @@map("products")
}

model ProductAddon {
  id          String  @id @default(cuid())
  productId   String
  name        String
  optionName  String?
  price       Decimal @default(0) @db.Decimal(10, 2)
  isAvailable Boolean @default(true)

  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItemAddons OrderItemAddon[]

  @@index([productId])
  @@map("product_addons")
}

model ShopProduct {
  id        String   @id @default(cuid())
  shopId    String
  productId String
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([shopId, productId])
  @@index([shopId])
  @@index([productId])
  @@map("shop_products")
}

// Order Management
model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  userId        String?
  shopId        String
  addressId     String?
  orderType     OrderType   @default(DINE_IN)
  tableNumber   String?
  pickupTime    DateTime?
  subtotal      Decimal     @db.Decimal(10, 2)
  tax           Decimal     @default(0) @db.Decimal(10, 2)
  deliveryFee   Decimal     @default(0) @db.Decimal(10, 2)
  discount      Decimal     @default(0) @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)
  status        OrderStatus @default(PENDING)
  paymentMethod String?
  paymentStatus PaymentStatus @default(UNPAID)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user    User?    @relation(fields: [userId], references: [id])
  shop    Shop     @relation(fields: [shopId], references: [id])
  address Address? @relation(fields: [addressId], references: [id])
  items   OrderItem[]

  @@index([userId])
  @@index([shopId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2) // Price at time of order
  subtotal  Decimal @db.Decimal(10, 2)
  notes     String?

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  addons   OrderItemAddon[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderItemAddon {
  id          String @id @default(cuid())
  orderItemId String
  productAddonId String
  quantity    Int    @default(1)

  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productAddon ProductAddon @relation(fields: [productAddonId], references: [id])

  @@index([orderItemId])
  @@index([productAddonId])
  @@map("order_item_addons")
}

// Enums
enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}
