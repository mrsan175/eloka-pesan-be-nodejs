# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ============================================
# Database - Neon PostgreSQL
# ============================================
# Pooled connection (untuk runtime aplikasi)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?channel_binding=require&sslmode=require"

# Direct connection (untuk Prisma migrate / studio)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ============================================
# Redis
# ============================================
# Dipakai hanya saat NODE_ENV=production
REDIS_URL="redis://default:PASSWORD@HOST:PORT"

# Dipakai saat NODE_ENV != production (Redis lokal)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT
# ============================================
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# CORS
# ============================================
CORS_ORIGIN=*

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# File Upload
# ============================================
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# ============================================
# QRIS Payment Gateway
# ============================================
# Secret yang dikirim gateway saat memanggil webhook
PAYMENT_WEBHOOK_SECRET=change-this-webhook-secret
# Payload QRIS dinamis dari provider. Kosongkan untuk mode development.
QRIS_STATIC_PAYLOAD=
PAYMENT_EXPIRY_MINUTES=15
# Set false setelah Xendit/Midtrans webhook sudah digunakan.
PAYMENT_SIMULATION_ENABLED=true
